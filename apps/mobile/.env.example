# Copy to .env and adjust for your environment.
# EXPO_PUBLIC_* values are inlined into the JS bundle at build time, so each
# EAS build uses the value present when the build is started.
#
# Local development (Android emulator):
#   EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:3000/api/v1
#
# Production (Render) — use for the production EAS build:
#   EXPO_PUBLIC_API_BASE_URL=https://budget-tracker-api-7f17.onrender.com/api/v1
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000/api/v1